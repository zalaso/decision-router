# Export these variables in your shell. This project does not auto-load .env files.
ROUTER_MODE=local
ROUTER_LOCAL_BACKEND=fake
# Possibili backend: fake, nli, openjev, rizzo_flow.
# Rizzo Flow è un servizio HTTP separato, raggiungibile solo su loopback.
ROUTER_RIZZO_BASE_URL=http://127.0.0.1:8017
ROUTER_RIZZO_MODEL=rizzo-latest
ROUTER_TIMEOUT_S=5
ROUTER_LOCAL_ACCEPT_CONFIDENCE=0.80
ROUTER_REVIEW_BELOW_CONFIDENCE=0.55
ROUTER_SAFETY_MIN_CONFIDENCE=0.80
ROUTER_RISK_THRESHOLD=0.30
ROUTER_INJECTION_THRESHOLD=0.30
ROUTER_MALICIOUS_THRESHOLD=0.30
ROUTER_LOCAL_FILES_ONLY=true
# JSON mapping, optional after calibration on labeled data.
ROUTER_TEMPERATURE_BY_QUESTION={}
ROUTER_LOCAL_STARTUP_TIMEOUT_S=120
ROUTER_MAX_REQUESTS_PER_MINUTE=60
ROUTER_MAX_CONCURRENT_REQUESTS=4
ROUTER_REQUIRE_HTTPS=false
# Supply real credentials only through the environment, never through YAML.
TYPESAFE_API_KEY=
RIZZO_API_KEY=
ROUTER_API_TOKEN=
